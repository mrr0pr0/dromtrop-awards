# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Resend (magic link emails)
RESEND_API_KEY=re_xxxxxxxx
# Local dev: use Resend test sender (recipients must be your Resend account email)
EMAIL_FROM=IT-Gullruten <onboarding@resend.dev>
# Local dev: log magic link in terminal — use any email (e.g. BOOTSTRAP_ADMIN_EMAIL)
AUTH_DEV_LOG_MAGIC_LINK=true
# Production: verify your domain at resend.com/domains, then e.g.:
# EMAIL_FROM=IT-Gullruten <noreply@yourdomain.com>
# AUTH_DEV_LOG_MAGIC_LINK must be unset or false in production

# Optional: first login with this email becomes admin
BOOTSTRAP_ADMIN_EMAIL=admin@school.no
