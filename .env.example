DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth.js (required)
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Optional: Resend for magic link emails
RESEND_API_KEY=
EMAIL_FROM=IT-Gullruten <noreply@example.com>

# Dev: print login link in terminal instead of sending email
AUTH_DEV_LOG_MAGIC_LINK=true

# Optional: first login with this email becomes admin
BOOTSTRAP_ADMIN_EMAIL=

# Controls whether jury members can currently submit votes
# Set to "true" to open voting, "false" to close it
JURY_VOTING_OPEN=true
