# Controls whether users can currently submit audience votes
# Set to "true" to open voting, "false" to close it
VOTING_OPEN=true

# Controls whether jury members can currently submit votes
# Set to "true" to open voting, "false" to close it
JURY_VOTING_OPEN=false

# to see results page, set to true
RESULTS_VISIBLE=false

